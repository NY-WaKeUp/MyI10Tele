# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/
venv/
env/

# Test / type / coverage tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Jupyter
.ipynb_checkpoints/

# OS / editor noise
.DS_Store
.history/
.specstory/

# Secrets / local env (do not commit keys)
.env
.env.*

# Experiment / run logs (optional local noise)
wandb/
lightning_logs/
*.log

# Large generated assets (teleop / dataset dumps — keeps Git UI under VS Code limits)
data/images/
data/videos/
data/chunk-*/
data/**/*.parquet

# Second dataset root (same policy as data/)
data2/images/
data2/videos/
data2/chunk-*/
data2/**/*.parquet
