<mujoco model="myscene">
    <size memory="500M"/>
    <option integrator="RK4" noslip_iterations="20" timestep="0.002"/>
    <include file="aubo_i10_inspire.xml"/>
    <include file="table.xml"/>
<worldbody>
    <!-- Black place deck: mocap body — pose set each reset in code (cube_xy + (-0.1,0), fixed z). -->
    <body name="place_target_platform" mocap="true" pos="0.1711248850767859 -1.1 0.238">
        <geom name="place_target_deck" type="box" size="0.025 0.03 0.0125" rgba="0.02 0.02 0.02 1" contype="1" conaffinity="1" friction="1.2 0.6 0.01"/>
    </body>
    <!-- Cube center z = table_top + geom half-height; table top z=0.23 (table.xml box pos.z + size.z). -->
    <body name="cube" pos="0.2711248850767859 -1.1 0.255">
      <!-- Offset from cube body origin to place_target_platform center (cube frame); drives mocap pose in env. -->
      <site name="place_target_delta" pos="-0.1 0 0" size="0.002" rgba="0 0 0 0"/>
      <freejoint/>
      <!-- Collision and inertia carrier -->
      <geom type="box" size="0.025 0.025 0.025" mass="0.070875" friction="3.0 2.0 0.003" contype="1" conaffinity="1" rgba="0 0 0 0"/>
      <!-- Visual-only colored faces -->
      <geom type="box" pos="-0.025 0 0" size="0.0005 0.025 0.025" mass="0" contype="0" conaffinity="0" rgba="1 0 0 1"/>
      <geom type="box" pos="0.025 0 0" size="0.0005 0.025 0.025" mass="0" contype="0" conaffinity="0" rgba="0 1 0 1"/>
      <geom type="box" pos="0 -0.025 0" size="0.025 0.0005 0.025" mass="0" contype="0" conaffinity="0" rgba="0 0 1 1"/>
      <geom type="box" pos="0 0.025 0" size="0.025 0.0005 0.025" mass="0" contype="0" conaffinity="0" rgba="1 1 0 1"/>
      <geom type="box" pos="0 0 -0.025" size="0.025 0.025 0.0005" mass="0" contype="0" conaffinity="0" rgba="0 1 1 1"/>
      <geom type="box" pos="0 0 0.025" size="0.025 0.025 0.0005" mass="0" contype="0" conaffinity="0" rgba="1 1 1 1"/>
    </body>
  </worldbody>
</mujoco>
